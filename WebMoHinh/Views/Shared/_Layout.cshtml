<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Web Mô Hình</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                🏆 Thành Tài
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Trang Chủ
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Index">
                            Sản Phẩm
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Category"
                           asp-action="Index">
                            Danh Mục
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Cart"
                           asp-action="Index">
                            🛒 Giỏ Hàng
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold"
                               asp-controller="Product"
                               asp-action="Create">
                                ➕ Thêm Sản Phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold"
                               asp-controller="Category"
                               asp-action="Index">
                                📂 Quản Lý Danh Mục
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold"
                               asp-controller="Order"
                               asp-action="Index">
                                📦 Đơn Hàng
                            </a>
                        </li>

                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Order"
                                   asp-action="Dashboard">
                                    📊 Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Order"
                                   asp-action="Report">
                                    📑 Báo Cáo
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold"
                               asp-controller="UserRole"
                               asp-action="Index">
                                👥 Phân Quyền
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Employee"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-info fw-bold"
                               asp-controller="Product"
                               asp-action="Create">
                                ➕ Thêm Sản Phẩm
                            </a>
                        </li>
                    }

                </ul>

                <ul class="navbar-nav">

                    @if (User.Identity != null &&
                    User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-warning">
                                Xin chào @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <span class="nav-link text-info">
                                Admin: @User.IsInRole("Admin")
                            </span>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-danger"
                               asp-controller="Account"
                               asp-action="Logout">
                                Đăng Xuất
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-light"
                               asp-controller="Account"
                               asp-action="Login">
                                Đăng Nhập
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-warning"
                               asp-controller="Account"
                               asp-action="Register">
                                Đăng Ký
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </div>
    </nav>

    <div class="container mt-4">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @RenderBody()

    </div>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container text-center">
            <h5>Web Bán Mô Hình Anime & Gundam</h5>
            <p class="mb-0">
                ASP.NET Core MVC - .NET 8
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
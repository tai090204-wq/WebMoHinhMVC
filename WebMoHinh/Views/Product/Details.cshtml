@model WebMoHinh.Models.Product

<div class="row">

    <div class="col-md-5">
        <img src="@Model.ImageUrl"
             class="img-fluid rounded shadow">
    </div>

    <div class="col-md-7">

        <h2>@Model.Name</h2>

        <h3 class="text-danger">
            @Model.Price.ToString("N0") VNĐ
        </h3>

        <p>@Model.Description</p>

        <p>
            Danh mục:
            <strong>@Model.Category?.Name</strong>
        </p>

    </div>

</div>
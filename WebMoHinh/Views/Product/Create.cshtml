@model WebMoHinh.Models.Product

<h2>Thêm Sản Phẩm</h2>

<form asp-action="Create"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label>Tên sản phẩm</label>
        <input asp-for="Name"
               class="form-control">
    </div>

    <div class="mb-3">
        <label>Mô tả</label>
        <textarea asp-for="Description"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Giá</label>
        <input asp-for="Price"
               class="form-control">
    </div>

    <div class="mb-3">
        <label>Số lượng</label>
        <input asp-for="Quantity"
               class="form-control">
    </div>

    <div class="mb-3">
        <label>Danh mục</label>
        <select asp-for="CategoryId"
                asp-items="ViewBag.CategoryId"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label>Ảnh</label>
        <input asp-for="ImageFile"
               class="form-control">
    </div>

    <button class="btn btn-success">
        Lưu
    </button>
</form>
@model WebMoHinh.ViewModels.RegisterViewModel

<div class="card shadow">

    <div class="card-header bg-success text-white">
        Đăng Ký Tài Khoản
    </div>

    <div class="card-body">

        <form asp-action="Register" method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Họ tên" />
                </div>

                <div class="col-md-6 mb-3">
                    <input asp-for="Age"
                           class="form-control"
                           placeholder="Tuổi" />
                </div>

                <div class="col-md-6 mb-3">
                    <input asp-for="Gender"
                           class="form-control"
                           placeholder="Giới tính" />
                </div>

                <div class="col-md-6 mb-3">
                    <input asp-for="Job"
                           class="form-control"
                           placeholder="Nghề nghiệp" />
                </div>

                <div class="col-md-12 mb-3">
                    <input asp-for="Address"
                           class="form-control"
                           placeholder="Địa chỉ" />
                </div>

                <div class="col-md-6 mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Email" />
                </div>

                <div class="col-md-6 mb-3">
                    <input asp-for="UserName"
                           class="form-control"
                           placeholder="Username" />
                </div>

                <div class="col-md-6 mb-3">
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Password" />
                </div>

                <div class="col-md-6 mb-3">
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Nhập lại Password" />
                </div>

                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Chọn quyền
                    </label>

                    <select asp-for="Role"
                            class="form-select">

                        <option value="Customer">
                            Customer
                        </option>

                        <option value="Employee">
                            Employee
                        </option>

                        <option value="Company">
                            Company
                        </option>

                        <option value="Admin">
                            Admin
                        </option>

                    </select>

                </div>

            </div>

            <button type="submit"
                    class="btn btn-success">
                Đăng Ký
            </button>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
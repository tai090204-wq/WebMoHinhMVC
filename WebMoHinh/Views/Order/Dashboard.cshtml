<h2>Dashboard Admin</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.TotalRevenue.ToString("N0")</h3>
                <p>Doanh Thu</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.TotalOrders</h3>
                <p>Đơn Hàng</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.TotalProducts</h3>
                <p>Sản Phẩm</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3>@ViewBag.TotalUsers</h3>
                <p>Người Dùng</p>
            </div>
        </div>
    </div>

</div>
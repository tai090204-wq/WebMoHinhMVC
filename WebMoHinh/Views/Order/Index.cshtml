@model IEnumerable<WebMoHinh.Models.Order>

<h2>Quản Lý Đơn Hàng</h2>

<table class="table table-bordered">

    <thead class="table-dark">
        <tr>
            <th>Mã</th>
            <th>Ngày Đặt</th>
            <th>Tổng Tiền</th>
            <th>Trạng Thái</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>#@item.Id</td>

                <td>
                    @item.OrderDate
                </td>

                <td>
                    @item.TotalAmount.ToString("N0")
                </td>

                <td>
                    @item.Status
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info">
                        Chi Tiết
                    </a>

                    <a asp-action="ChangeStatus"
                       asp-route-id="@item.Id"
                       asp-route-status="Processing"
                       class="btn btn-warning">
                        Processing
                    </a>

                    <a asp-action="ChangeStatus"
                       asp-route-id="@item.Id"
                       asp-route-status="Completed"
                       class="btn btn-success">
                        Completed
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
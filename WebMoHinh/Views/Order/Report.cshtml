@model WebMoHinh.Models.ReportViewModel

@{
    ViewData["Title"] = "Báo Cáo Thống Kê";
}

<h2 class="mb-4">📑 Báo Cáo Thống Kê</h2>

<form method="get" class="row mb-4">

    <div class="col-md-3">
        <label>Từ ngày</label>
        <input type="date"
               name="fromDate"
               value="@Model.FromDate.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>

    <div class="col-md-3">
        <label>Đến ngày</label>
        <input type="date"
               name="toDate"
               value="@Model.ToDate.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <label>&nbsp;</label>
        <button class="btn btn-primary w-100">
            Thống kê
        </button>
    </div>

</form>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>Doanh Thu</h5>
                <h3 class="text-danger">
                    @Model.TotalRevenue.ToString("N0") VNĐ
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>Đơn Hàng</h5>
                <h3 class="text-success">
                    @Model.TotalOrders
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>Khách Hàng</h5>
                <h3 class="text-primary">
                    @Model.TotalCustomers
                </h3>
            </div>
        </div>
    </div>

</div>
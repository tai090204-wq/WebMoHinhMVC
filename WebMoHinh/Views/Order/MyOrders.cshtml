@model IEnumerable<WebMoHinh.Models.Order>

<h2>Lịch Sử Đơn Hàng</h2>

<table class="table table-bordered">

    <thead class="table-dark">
        <tr>
            <th>Mã Đơn</th>
            <th>Ngày Đặt</th>
            <th>Tổng Tiền</th>
            <th>Trạng Thái</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>#@item.Id</td>

                <td>
                    @item.OrderDate
                </td>

                <td>
                    @item.TotalAmount.ToString("N0")
                </td>

                <td>
                    @item.Status
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info">

                        Chi Tiết

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>